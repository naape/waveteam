# SAFETY NET — the project folder itself must never be served on the web.
# Only the public/ folder should be published (as https://www.waveteam.lk/app,
# via:  ln -s ~/waveteam/public ~/public_html/app). If this repository was cloned
# INTO public_html by mistake, this rule keeps .env, composer.json, storage/,
# logs and source code private (everything answers 403 Forbidden).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

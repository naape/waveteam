# ---------------------------------------------------------------------------
# WaveTeam Portal — PRODUCTION environment (copy to .env on the server)
# Fill every CHANGE_ME_ value. Never commit the real .env.
# Generate the three keys with:  php artisan portal:install  (does it for you)
# ---------------------------------------------------------------------------
APP_NAME="WaveTeam Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The portal runs in the /app folder of the main website.
APP_URL=https://www.waveteam.lk/app
APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Encryption keys — BACK THESE UP SEPARATELY FROM DATABASE BACKUPS.
# Losing them makes NIC numbers and uploaded documents unreadable.
BLIND_INDEX_KEY=
DOCUMENT_ENCRYPTION_KEY=

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_database_name
DB_USERNAME=CHANGE_ME_database_user
DB_PASSWORD=CHANGE_ME_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Cookies are limited to /app (taken from APP_URL), so they never mix with
# WordPress's. Leave SESSION_DOMAIN and SESSION_PATH empty.
SESSION_DOMAIN=
SESSION_PATH=
SESSION_COOKIE=waveteam_portal_session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Private documents. Put OUTSIDE the web root and include in backups.
DOCUMENTS_ROOT=CHANGE_ME_absolute_path

# Email — use a transactional provider (SES / Brevo / Postmark) with SPF+DKIM+DMARC.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME_smtp_host
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_smtp_user
MAIL_PASSWORD=CHANGE_ME_smtp_password
MAIL_FROM_ADDRESS="no-reply@waveteam.lk"
MAIL_FROM_NAME="WaveTeam Engineering"

# Admin panel
ADMIN_PATH=admin
ADMIN_IP_ALLOWLIST=
EMAIL_VERIFICATION_REQUIRED=true
ADMIN_MFA_REQUIRED=true
TRUSTED_PROXIES=
SEED_ADMIN_EMAIL=admin@waveteam.lk

# SMS / WhatsApp (off until a provider is contracted)
SMS_ENABLED=false
WHATSAPP_ENABLED=false
TEXT_MESSAGE_DRIVER=log

REPORT_INLINE_LIMIT=2000
REPORT_PDF_LIMIT=5000
